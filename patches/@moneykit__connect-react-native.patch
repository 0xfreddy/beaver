+    private static func beaverTheme() -> MKTheme {
+        var theme = MKTheme()
+
+        var colors = MKColors()
+        colors.tint = .white
+        colors.primaryForeground = UIColor(
+            red: 27 / 255.0, green: 27 / 255.0, blue: 27 / 255.0, alpha: 1
+        )
+        theme.colors = colors
+
+        var button = theme.controls.button
+        button.height = 54
+        button.cornerStyle = .custom(12)
+        theme.controls.button = button
+
+        return theme
+    }
