# Copy to apps/mobile/.env. Every value below is optional: the app runs in
# mock mode with a sample account and needs no keys or backend.

# Mock mode intercepts API requests locally, but the client still wants a
# well-formed base URL. Leave as-is for local development.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Mock data defaults ON outside production builds; set false to exercise the
# live HTTP path (requires a reachable account service).
EXPO_PUBLIC_MOCK_DATA_ENABLED=true

# Use devnet unless you have a reason not to. Production builds must use mainnet.
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# Only needed to sign in against a real account service (not for mock mode).
# Create a React Native client in the Privy dashboard and allow your bundle ID
# and URL scheme.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Leave empty to disable telemetry.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Only relevant if you fork and build with your own EAS project (OTA updates).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Enable only after configuring Apple OAuth for your app identifier.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

APP_ENV=development
